# ============================================================================
# Industrial IoT Predictive Maintenance - Environment Configuration
# ============================================================================

# ThingSpeak Credentials for Physical Hardware Edge Ingestion
# Channel 3591448 is private; obtain the Read API Key from ThingSpeak Channel Settings.
TS_CHANNEL_ID=3591448
TS_READ_KEY=YOUR_THINGSPEAK_READ_API_KEY_HERE

# Optional Local Telemetry Fallback CSV Path
# When TS_READ_KEY is not set or network is offline, the backend reads from this file.
LIVE_DATA_FALLBACK_CSV=./feeds.csv

# Application Server Configuration (Local Development)
HOST=127.0.0.1
PORT=8000

